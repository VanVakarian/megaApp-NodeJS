APP_ENV=test
APP_HOST=127.0.0.1
APP_PORT=3000
LOG_LEVEL=debug

DATA_DIR=./data
DB_NAME=megaapp
DB_ENV=test
DB_VERSION=005

MIGRATIONS_DIR=./migrations
PUBLIC_DIR=./public
BACKUPS_DIR=./backups
JWT_SECRET=test-insecure-jwt-secret
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-pro
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
OPENROUTER_TIMEOUT_SECONDS=60
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=768
OPENAI_TIMEOUT_SECONDS=60
QUOTES_JOB_ENABLED=false
QUOTES_JOB_SCHEDULE=0 3 * * *
QUOTES_FETCH_DAYS=7
QUOTES_RETRY_ATTEMPTS=3
QUOTES_RETRY_DELAY_SECONDS=30
QUOTES_REQUEST_TIMEOUT_SECONDS=20
HTTP_READ_TIMEOUT_SECONDS=15
HTTP_WRITE_TIMEOUT_SECONDS=30
HTTP_IDLE_TIMEOUT_SECONDS=60
SHUTDOWN_TIMEOUT_SECONDS=10
MAX_REQUEST_BODY_BYTES=1048576
MAX_MULTIPART_BODY_BYTES=8388608
WS_READ_LIMIT_BYTES=65536
WS_WRITE_TIMEOUT_SECONDS=5
